// The userland `math` functions against reference values from the platform
// libm (and a correctly rounded cube root): exact for sqrt / floor / ceil /
// cbrt and within 2 ulp for the rest, over inputs from 2^-60 to 2^60, huge
// trig arguments, subnormals, the exp overflow edges and IEEE specials.
// The tables at the end come from scripts/gen_math_cases.py.
use tests::assert;
use math::{sin, cos, tan, sqrt, floor, ceil, exp, ln, atan, atan2, asin, acos, log10, log2, cbrt, sinh, cosh, tanh};
use num::{E, PI, abs};
use string::format;

const INF = (2.0 ** 1023.0) * 2.0;

const NAN = INF - INF;

