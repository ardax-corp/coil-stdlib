// `a` and `b` are the same float: NaN matches NaN and the zeros keep their sign.
fn same(float a, float b) -> bool {
    if a != a {
        return b != b;
    }
    if a == 0.0 && b == 0.0 {
        return 1.0 / a == 1.0 / b;
    }
    return a == b;
}

// `a` is within `ulps` units in the last place of `b`.
fn near(float a, float b, float ulps) -> bool {
    if same(a, b) {
        return true;
    }
    if a != a || b != b || !(b - b == 0.0) {
        return false;
    }
    let ab = abs(b);
    let ulp = 2.0 ** -1074.0;
    if ab >= 2.0 ** -1022.0 {
        // Largest power of two not above |b|, times 2^-52.
        let p = 1.0;
        while p * 2.0 <= ab {
            p = p * 2.0;
        }
        while p > ab {
            p = p * 0.5;
        }
        ulp = p * (2.0 ** -52.0);
    }
    return abs(a - b) <= ulps * ulp;
}

// `f` on every (input, expected) pair of `cases`, within `ulps` (0 = exact).
fn check(string name, fn(float) -> float f, Vec<float> cases, float ulps) -> Result<(), string> {
    let i = 0;
    while i < cases.len() {
        let x = cases[i];
        let want = cases[i + 1];
        let got = f(x);
        assert!(near(got, want, ulps), format("%s(%v) = %v, want %v", name, x, got, want));
        i = i + 2;
    }
    return Result::Ok(());
}

test("sqrt floor ceil cbrt are exact") {
    check("sqrt", fn (float x) => sqrt(x), sqrt_cases(), 0.0)?;
    check("floor", fn (float x) => floor(x), floor_cases(), 0.0)?;
    check("ceil", fn (float x) => ceil(x), ceil_cases(), 0.0)?;
    check("cbrt", fn (float x) => cbrt(x), cbrt_cases(), 0.0)?;
}

test("sin cos tan") {
    check("sin", fn (float x) => sin(x), sin_cases(), 2.0)?;
    check("cos", fn (float x) => cos(x), cos_cases(), 2.0)?;
    check("tan", fn (float x) => tan(x), tan_cases(), 2.0)?;
}

test("exp ln log2 log10") {
    check("exp", fn (float x) => exp(x), exp_cases(), 2.0)?;
    check("ln", fn (float x) => ln(x), ln_cases(), 2.0)?;
    check("log2", fn (float x) => log2(x), log2_cases(), 2.0)?;
    check("log10", fn (float x) => log10(x), log10_cases(), 2.0)?;
}

test("atan asin acos") {
    check("atan", fn (float x) => atan(x), atan_cases(), 2.0)?;
    check("asin", fn (float x) => asin(x), asin_cases(), 2.0)?;
    check("acos", fn (float x) => acos(x), acos_cases(), 2.0)?;
}

test("atan2") {
    let cases = atan2_cases();
    let i = 0;
    while i < cases.len() {
        let y = cases[i];
        let x = cases[i + 1];
        let want = cases[i + 2];
        let got = atan2(y, x);
        assert!(near(got, want, 2.0), format("atan2(%v, %v) = %v, want %v", y, x, got, want));
        i = i + 3;
    }
}

test("sinh cosh tanh") {
    check("sinh", fn (float x) => sinh(x), sinh_cases(), 2.0)?;
    check("cosh", fn (float x) => cosh(x), cosh_cases(), 2.0)?;
    check("tanh", fn (float x) => tanh(x), tanh_cases(), 2.0)?;
}

test("exact results") {
    assert!(exp(0.0) == 1.0);
    assert!(exp(1.0) == E);
    assert!(ln(E) == 1.0);
    assert!(cos(PI) == -1.0);
    assert!(atan2(0.0, -1.0) == PI);
    let n = 0;
    while n < 60 {
        let p = 2.0 ** (n as float);
        assert!(log2(p) == n as float);
        assert!(log2(1.0 / p) == 0.0 - (n as float));
        assert!(sqrt(p * p) == p);
        let r = (n * 1000 + 7) as float;
        assert!(cbrt(r * r * r) == r);
        assert!(cbrt(0.0 - r * r * r) == 0.0 - r);
        n = n + 1;
    }
    let t = 1.0;
    let k = 0;
    while k < 23 {
        assert!(log10(t) == k as float);
        t = t * 10.0;
        k = k + 1;
    }
    assert!(floor(-0.5) == -1.0);
    assert!(same(ceil(-0.5), -0.0));
    assert!(same(floor(-0.0), -0.0));
    assert!(same(tanh(-0.0), -0.0));
}
