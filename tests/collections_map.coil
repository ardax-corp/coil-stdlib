use tests::assert;
use collections::map::HashMap;
use string::format;

test("hashmap insert get update remove") {
    let m = HashMap::new();
    assert!(m.insert(1, "a"));
    assert!(m.insert(2, "b"));
    assert!(m.insert(1, "A") == false);
    assert!(m.len() == 2);
    assert!(m.get_or(1, "?") == "A");
    assert!(m.get_or(2, "?") == "b");
    assert!(m.get_or(3, "?") == "?");
    assert!(m.contains(2));
    assert!(m.contains(9) == false);
    assert!(m.remove(2));
    assert!(m.contains(2) == false);
    assert!(m.len() == 1);
    m.clear();
    assert!(m.is_empty());
}

test("hashmap remove missing") {
    let m = HashMap::new();
    assert!(m.remove(1) == false);
    assert!(m.is_empty());
}

test("hashmap reinsert after remove") {
    let m = HashMap::new();
    assert!(m.insert(1, 10));
    assert!(m.remove(1));
    assert!(m.insert(1, 20));
    assert!(m.get_or(1, -1) == 20);
    assert!(m.len() == 1);
}

test("hashmap clear then insert") {
    let m = HashMap::new();
    assert!(m.insert(1, 10));
    m.clear();
    assert!(m.is_empty());
    assert!(m.insert(2, 30));
    assert!(m.len() == 1);
    assert!(m.get_or(2, -1) == 30);
    assert!(m.contains(1) == false);
}

test("hashmap capacity holds what was asked for") {
    let m: HashMap<int, int> = HashMap::with_capacity(3);
    assert!(m.capacity() >= 3);
    let n: HashMap<int, int> = HashMap::with_capacity(100);
    assert!(n.capacity() >= 100);
}

test("hashmap single grow preserves entries") {
    let m = HashMap::new();
    let before = m.capacity();
    let i = 0;
    while i < before + 1 {
        assert!(m.insert(i, i + 100));
        i = i + 1;
    }
    assert!(m.capacity() > before);
    assert!(m.len() == before + 1);
    assert!(m.get_or(0, -1) == 100);
    assert!(m.get_or(4, -1) == 104);
    assert!(m.contains(3));
    assert!(m.contains(9) == false);
}

test("hashmap keys values") {
    let m = HashMap::new();
    assert!(m.insert(1, 10));
    assert!(m.insert(2, 20));
    let ks = m.keys();
    let vs = m.values();
    assert!(ks.len() == 2);
    assert!(vs.len() == 2);
}

test("hashmap entry counts with one lookup per key") {
    let counts: HashMap<string, int> = HashMap::new();
    let words = ["to", "be", "or", "not", "to", "be", "to"];
    for w in words {
        let _ = counts.entry(w).and_modify(fn (int n) => n + 1).or_insert(1);
    }
    assert!(counts.len() == 4);
    assert!(counts.get_or("to", 0) == 3);
    assert!(counts.get_or("be", 0) == 2);
    assert!(counts.get_or("not", 0) == 1);
    assert!(counts.entry("or").and_modify(fn (int n) => n * 10).or_insert(0) == 10);
    assert!(counts.entry("new").and_modify(fn (int n) => n + 1).or_insert(7) == 7);
    assert!(counts.len() == 5);
}

test("hashmap many removes and reinserts keep every key findable") {
    let m: HashMap<int, int> = HashMap::new();
    let i = 0;
    while i < 2000 {
        m.insert(i, i * 2);
        i = i + 1;
    }
    i = 0;
    while i < 2000 {
        if i % 3 != 0 {
            assert!(m.remove(i));
        }
        i = i + 1;
    }
    assert!(m.len() == 667);
    i = 0;
    while i < 2000 {
        assert!(m.contains(i) == (i % 3 == 0));
        i = i + 1;
    }
    i = 0;
    while i < 2000 {
        if i % 3 == 1 {
            m.insert(i, -i);
        }
        i = i + 1;
    }
    assert!(m.len() == 1334);
    assert!(m.get_or(1, 0) == -1);
    assert!(m.get_or(3, 0) == 6);
    assert!(m.get_or(2, 0) == 0);
}

test("hashmap churn on a small map does not grow without bound") {
    let m: HashMap<int, int> = HashMap::new();
    let i = 0;
    while i < 5000 {
        m.insert(i, i);
        assert!(m.remove(i));
        i = i + 1;
    }
    assert!(m.is_empty());
    assert!(m.capacity() <= 16);
}

test("hashmap keeps insertion order across growth and removal") {
    let m: HashMap<string, int> = HashMap::new();
    let i = 0;
    while i < 100 {
        m.insert(format("k%i", i), i);
        i = i + 1;
    }
    m.remove("k0");
    m.remove("k50");
    m.insert("k0", 0);
    let ks = m.keys();
    assert!(ks.len() == 99);
    assert!(ks[0] == "k1");
    assert!(ks[48] == "k49");
    assert!(ks[49] == "k51");
    assert!(ks[98] == "k0");
}

test("hashmap float keys and colliding int keys") {
    let f: HashMap<float, int> = HashMap::new();
    let i = 0;
    while i < 300 {
        f.insert(i as float, i);
        i = i + 1;
    }
    assert!(f.len() == 300);
    assert!(f.get_or(299.0, -1) == 299);
    assert!(f.get_or(0.5, -1) == -1);
    let c: HashMap<int, int> = HashMap::new();
    i = 0;
    while i < 300 {
        c.insert(i * 1024, i);
        i = i + 1;
    }
    assert!(c.get_or(299 * 1024, -1) == 299);
    assert!(c.get_or(1023, -1) == -1);
    assert!(c.remove(1024));
    assert!(c.get_or(2048, -1) == 2);
}
