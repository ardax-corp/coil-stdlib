use tests::assert;
use collections::map::HashMap;

test("hashmap or_insert keeps an existing value") {
    let m: HashMap<string, int> = HashMap::new();
    assert!(m.or_insert("a", 1) == 1);
    assert!(m.or_insert("a", 2) == 1);
    assert!(m.or_insert("b", 3) == 3);
    assert!(m.len() == 2);
    assert!(m.get_or("a", 0) == 1);
    assert!(m.get_or("b", 0) == 3);
}

test("hashmap or_insert across growth") {
    let m: HashMap<int, int> = HashMap::new();
    let i = 0;
    while i < 1000 {
        assert!(m.or_insert(i % 300, i) == i % 300);
        i = i + 1;
    }
    assert!(m.len() == 300);
    assert!(m.get_or(299, -1) == 299);
}

test("hashmap or_insert_with runs make only for a new key") {
    let m: HashMap<int, int> = HashMap::new();
    let calls: Vec<int> = Vec::new();
    let make = fn () use (mut calls) {
        calls.push(1);
        return 7;
    };
    assert!(m.or_insert_with(1, make) == 7);
    m.insert(1, 9);
    assert!(m.or_insert_with(1, make) == 9);
    assert!(calls.len() == 1);
}

test("hashmap and_update leaves a missing key missing") {
    let m: HashMap<int, string> = HashMap::new();
    m.insert(1, "a");
    assert!(m.and_update(1, "b"));
    assert!(!m.and_update(2, "c"));
    assert!(m.get_or(1, "?") == "b");
    assert!(!m.contains(2));
    assert!(m.len() == 1);
}

test("hashmap and_update_with then or_insert counts") {
    let m: HashMap<string, int> = HashMap::new();
    for w in ["a", "b", "a", "c", "a"] {
        if !m.and_update_with(w, fn (int n) => n + 1) {
            m.insert(w, 1);
        }
    }
    assert!(m.get_or("a", 0) == 3);
    assert!(m.get_or("b", 0) == 1);
    assert!(m.len() == 3);
}

test("hashmap and_update after remove") {
    let m: HashMap<int, int> = HashMap::new();
    m.insert(1, 10);
    m.remove(1);
    assert!(!m.and_update(1, 11));
    assert!(m.or_insert(1, 12) == 12);
    assert!(m.len() == 1);
}
