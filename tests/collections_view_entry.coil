// The view forms of the map entry and vector slot: `m.entry(k)` and
// `xs.slot(i)` borrow their collection, so calls on them write it.
use tests::assert;
use collections::map::HashMap;
use collections::vec::VecSlots;

test("entry or_insert stores only for a new key") {
    let m: HashMap<string, int> = HashMap::new();
    assert!(m.entry("a").or_insert(1) == 1);
    assert!(m.entry("a").or_insert(2) == 1);
    assert!(m.len() == 1);
}

test("entry and_update then or_insert counts words") {
    let m: HashMap<string, int> = HashMap::new();
    for w in ["x", "y", "x", "z", "x", "y"] {
        let _ = m.entry(w).and_modify(fn (int n) => n + 1).or_insert(1);
    }
    assert!(m.get_or("x", 0) == 3);
    assert!(m.get_or("y", 0) == 2);
    assert!(m.get_or("z", 0) == 1);
}

test("entry and_update leaves a missing key missing") {
    let m: HashMap<string, int> = HashMap::new();
    let _ = m.entry("a").and_update(5);
    assert!(!m.contains("a"));
    m.insert("a", 1);
    let _ = m.entry("a").and_update(5);
    assert!(m.get_or("a", 0) == 5);
}

test("entry or_insert_with runs make only for a new key") {
    let m: HashMap<int, Vec<int>> = HashMap::new();
    let first = m.entry(1).or_insert_with(fn () => Vec::with_capacity(7));
    let again = m.entry(1).or_insert_with(fn () => Vec::with_capacity(8));
    assert!(first.capacity() == again.capacity());
    assert!(m.len() == 1);
}

test("entry key, exists and get_or") {
    let m: HashMap<string, int> = HashMap::new();
    m.insert("a", 4);
    let e = m.entry("a");
    assert!(e.key() == "a" && e.exists() && e.get_or(0) == 4);
    assert!(!m.entry("b").exists() && m.entry("b").get_or(-1) == -1);
}

test("entry across growth") {
    let m: HashMap<int, int> = HashMap::new();
    for i in 0..2000 {
        let _ = m.entry(i % 500).and_modify(fn (int n) => n + 1).or_insert(1);
    }
    assert!(m.len() == 500);
    assert!(m.get_or(499, 0) == 4);
}

test("a map copy taken before an entry keeps its values") {
    let m: HashMap<string, int> = HashMap::new();
    m.insert("a", 1);
    let before = m;
    let _ = m.entry("a").and_update(9);
    assert!(m.get_or("a", 0) == 9);
    assert!(before.get_or("a", 0) == 1);
}

test("slot set and update write the vector") {
    let xs: Vec<int> = [1, 2, 3];
    let _ = xs.slot(0).set(10).update(fn (int x) => x + 1);
    assert!(xs[0] == 11);
    assert!(xs.slot(0).get() == 11 && xs.slot(2).index() == 2);
}

test("slot in a loop") {
    let xs: Vec<int> = [0, 0, 0, 0];
    for r in 0..100 {
        let _ = xs.slot(r % 4).update(fn (int x) use (r) => x + r);
    }
    assert!(xs[0] + xs[1] + xs[2] + xs[3] == 4950);
}
