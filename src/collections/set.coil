// HashSet — a KeyIndex of the values.

use collections::index::KeyIndex;

/// A set of unique values.
///
/// Values need `Eq` and `Hash`. Backed by a `KeyIndex<T>`.
///
/// # Examples
///
/// ```
/// use collections::set::{HashSet};
/// # use tests::assert;
/// let tags: HashSet<string> = HashSet::new();
/// assert!(tags.insert("red"));
/// assert!(!tags.insert("red"));
/// assert!(tags.contains("red"));
/// assert!(tags.len() == 1);
/// ```
class HashSet<T> {
    inner: KeyIndex<T>,
}

impl HashSet<T> {
    /// Creates an empty set with room for `cap` values before it grows.
    pub static fn with_capacity(int cap) -> HashSet<T> {
        return new HashSet(KeyIndex::with_capacity(cap));
    }

    /// Creates an empty set.
    pub static fn new() -> HashSet<T> {
        return HashSet::with_capacity(0);
    }

    /// Number of elements.
    pub fn len() -> int {
        return self.inner.len();
    }

    /// Returns `true` when the set has no values.
    pub fn is_empty() -> bool {
        return self.inner.is_empty();
    }

    /// Remove all elements.
    pub fn clear() {
        self.inner.clear();
    }
}

impl HashSet<T: Eq + Hash> {
    /// Insert `x`; returns `true` when newly added.
    pub fn insert(T x) -> bool {
        let n = self.inner.slots();
        let _ = self.inner.insert(x);
        return self.inner.slots() > n;
    }

    /// True when `x` is present.
    pub fn contains(T x) -> bool {
        return self.inner.find(x) >= 0;
    }

    /// Remove `x`; returns `true` when an element was removed.
    pub fn remove(T x) -> bool {
        if self.inner.remove(x) < 0 {
            return false;
        }
        if self.inner.needs_compact() {
            self.inner.compact();
        }
        return true;
    }
}
