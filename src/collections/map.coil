// HashMap — a KeyIndex of the keys plus each slot's value, in insertion
// order as CPython's compact dict. No Default on K/V.
use collections::index::KeyIndex;

/// One key-value pair, as `HashMap` iteration yields it.
class Pair<K, V> {
    /// The key.
    pub key: K,
    /// The value stored under `key`.
    pub value: V,
}

/// A hash map from keys of type `K` to values of type `V`.
///
/// Keys need `Eq` and `Hash` (the primitive types have both; `#[derive(Eq, Hash)]`
/// adds them to your own types). Inserting an existing key replaces its value.
/// Iteration (`for e in m`, `m.keys()`, `m.values()`) visits entries in
/// insertion order, skipping removed ones.
///
/// `get` takes a fallback instead of returning an `Option`; use `contains` first
/// when the fallback could be a real value.
///
/// To read or change one key's value with one lookup, use `entry(k)`, a view
/// whose `or_insert` and `and_modify` write the map
/// (`m.entry(w).and_modify(fn (int n) => n + 1).or_insert(1)`), or the
/// one-call forms `upsert`, `or_insert` and `and_update`.
///
/// # Examples
///
/// ```
/// use collections::map::{HashMap};
/// # use tests::assert;
/// let ages: HashMap<string, int> = HashMap::new();
/// ages.insert("ada", 36);
/// ages.insert("alan", 41);
/// ages.insert("ada", 37);
/// assert!(ages.len() == 2);
/// assert!(ages.get_or("ada", 0) == 37);
/// assert!(ages.get_or("grace", -1) == -1);
///
/// let total = 0;
/// for e in ages {
///     total = total + e.value;
/// }
/// assert!(total == 78);
/// ```
class HashMap<K, V> {
    /// Keys to slots, in insertion order. Prefer the map's methods.
    pub idx: KeyIndex<K>,
    /// Each slot's value, removed slots included until the index compacts.
    /// Prefer `values()`.
    pub vals: Vec<V>,
}

/// One key's place in a `HashMap`, from `HashMap::entry`: a view that
/// borrows the map, so its methods write the map itself. The key is looked
/// up once, when the entry is made; `or_insert` and `and_update` then work
/// on that slot.
///
/// An entry is a view: use it in the expression that makes it, or keep it
/// in a local while nothing else uses the map.
///
/// # Examples
///
/// ```
/// use collections::map::{HashMap};
/// # use tests::assert;
/// let counts: HashMap<string, int> = HashMap::new();
/// for w in ["a", "b", "a"] {
///     let _ = counts.entry(w).and_modify(fn (int n) => n + 1).or_insert(1);
/// }
/// assert!(counts.get_or("a", 0) == 2);
/// assert!(counts.get_or("b", 0) == 1);
/// ```
view class Entry<K, V> {
    mut map: HashMap<K, V>,
    key: K,
    /// The key's slot in `map`, or negative when the map has no entry for it.
    slot: int,
}

/// An iterator over the entries of a `HashMap`, from `HashMap::iter`.
class HashMapIter<K, V> {
    map: HashMap<K, V>,
    slot: int,
}

impl HashMap<K, V> {
    /// Creates an empty map with room for `cap` entries before it grows.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<int, string> = HashMap::with_capacity(100);
    /// assert!(m.is_empty());
    /// assert!(m.capacity() >= 100);
    /// ```
    pub static fn with_capacity(int cap) -> HashMap<K, V> {
        let vals: Vec<V> = Vec::with_capacity(cap);
        return new HashMap(KeyIndex::with_capacity(cap), vals);
    }

    /// Creates an empty map.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// assert!(m.len() == 0);
    /// ```
    pub static fn new() -> HashMap<K, V> {
        return HashMap::with_capacity(0);
    }

    /// Returns the number of entries.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("a", 1);
    /// m.insert("b", 2);
    /// m.remove("a");
    /// assert!(m.len() == 1);
    /// ```
    pub fn len() -> int {
        return self.idx.len();
    }

    /// Returns `true` when the map has no entries.
    pub fn is_empty() -> bool {
        return self.idx.is_empty();
    }

    /// Returns how many entries the map holds before it grows.
    pub fn capacity() -> int {
        return self.idx.capacity();
    }

    /// Removes every entry, keeping the capacity.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<int, int> = HashMap::new();
    /// m.insert(1, 10);
    /// m.clear();
    /// assert!(m.is_empty());
    /// assert!(!m.contains(1));
    /// ```
    pub fn clear()
        ensures self.len() == 0
    {
        self.idx.clear();
        self.vals.clear();
    }

    /// Returns the keys, in insertion order.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("x", 1);
    /// m.insert("y", 2);
    /// let ks = m.keys();
    /// assert!(ks.len() == 2);
    /// assert!(ks[0] == "x");
    /// ```
    pub fn keys() -> Vec<K>
        ensures result.len() == self.len()
    {
        return self.idx.keys();
    }

    /// Returns the values, in the insertion order of their keys.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("x", 1);
    /// m.insert("y", 2);
    /// let vs = m.values();
    /// assert!(vs[0] + vs[1] == 3);
    /// ```
    pub fn values() -> Vec<V>
        ensures result.len() == self.len()
    {
        let out: Vec<V> = Vec::with_capacity(self.idx.len());
        let i = 0;
        while i < self.vals.len() {
            if self.idx.is_live(i) {
                out.push(self.vals[i]);
            }
            i = i + 1;
        }
        return out;
    }

    /// Returns an iterator over the entries, in insertion order.
    ///
    /// `for e in m` does the same; each item is a `Pair` with `key` and `value`.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("a", 1);
    /// let it = m.iter();
    /// let first = match it.next() {
    ///     Option::Some(e) => e.key,
    ///     Option::None => "",
    /// };
    /// assert!(first == "a");
    /// ```
    pub fn iter() -> HashMapIter<K, V> {
        return new HashMapIter(self, 0);
    }
}

impl HashMap<K: Eq + Hash, V> {
    // The slot holding `k`, or -1.
    fn find(K k) -> int {
        return self.idx.find(k);
    }

    /// Stores `v` under `k`, replacing any value already there.
    ///
    /// Returns `true` when `k` is new and `false` when an existing value was replaced.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// assert!(m.insert("a", 1));
    /// assert!(!m.insert("a", 2));
    /// assert!(m.get_or("a", 0) == 2);
    /// ```
    pub fn insert(K k, V v) -> bool {
        let h = k.hash();
        let s = self.idx.find_hashed(k, h);
        if s >= 0 {
            self.vals[s] = v;
            return false;
        }
        let _ = self.idx.push_hashed(k, h);
        self.vals.push(v);
        return true;
    }

    /// Stores `init` under `k` when it has no entry, else replaces its value
    /// `old` with `f(old)`, with one lookup. Returns the value now stored.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let counts: HashMap<string, int> = HashMap::new();
    /// for w in ["a", "b", "a"] {
    ///     counts.upsert(w, 1, fn (int n) => n + 1);
    /// }
    /// assert!(counts.get_or("a", 0) == 2);
    /// assert!(counts.get_or("b", 0) == 1);
    /// ```
    pub fn upsert(K k, V init, V -> V f) -> V {
        let h = k.hash();
        let s = self.idx.find_hashed(k, h);
        if s >= 0 {
            let v = f(self.vals[s]);
            self.vals[s] = v;
            return v;
        }
        let _ = self.idx.push_hashed(k, h);
        self.vals.push(init);
        return init;
    }

    /// Returns the value stored under `k`, storing `v` there first when
    /// `k` has no entry, with one lookup.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// assert!(m.or_insert("a", 1) == 1);
    /// assert!(m.or_insert("a", 2) == 1);
    /// assert!(m.len() == 1);
    /// ```
    pub fn or_insert(K k, V v) -> V {
        let h = k.hash();
        let s = self.idx.find_hashed(k, h);
        if s >= 0 {
            return self.vals[s];
        }
        let _ = self.idx.push_hashed(k, h);
        self.vals.push(v);
        return v;
    }

    /// Returns the value stored under `k`, storing `make()` there first
    /// when `k` has no entry. `make` runs only for a new key.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<int, Vec<int>> = HashMap::new();
    /// let v = m.or_insert_with(1, fn () => Vec::new());
    /// assert!(v.len() == 0);
    /// assert!(m.contains(1));
    /// ```
    pub fn or_insert_with(K k, () -> V make) -> V {
        let h = k.hash();
        let s = self.idx.find_hashed(k, h);
        if s >= 0 {
            return self.vals[s];
        }
        let v = make();
        let _ = self.idx.push_hashed(k, h);
        self.vals.push(v);
        return v;
    }

    /// Replaces the value stored under `k` with `v` when `k` has an
    /// entry; a missing key stays missing. Returns `true` when it had one.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("a", 1);
    /// assert!(m.and_update("a", 5));
    /// assert!(!m.and_update("b", 5));
    /// assert!(m.get_or("a", 0) == 5);
    /// assert!(!m.contains("b"));
    /// ```
    pub fn and_update(K k, V v) -> bool {
        let s = self.idx.find(k);
        if s >= 0 {
            self.vals[s] = v;
            return true;
        }
        return false;
    }

    /// Replaces the value `old` stored under `k` with `f(old)` when `k`
    /// has an entry; a missing key stays missing. Returns `true` when it
    /// had one.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("a", 1);
    /// assert!(m.and_modify("a", fn (int n) => n * 10));
    /// assert!(!m.and_modify("b", fn (int n) => n * 10));
    /// assert!(m.get_or("a", 0) == 10);
    /// ```
    pub fn and_modify(K k, V -> V f) -> bool {
        let s = self.idx.find(k);
        if s >= 0 {
            self.vals[s] = f(self.vals[s]);
            return true;
        }
        return false;
    }

    /// The place of `k` in the map, looked up once: `or_insert`,
    /// `and_update` and the other `Entry` methods work on it.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// assert!(m.entry("a").or_insert(1) == 1);
    /// assert!(m.entry("a").or_insert(2) == 1);
    /// assert!(m.entry("a").exists() && !m.entry("b").exists());
    /// ```
    pub fn entry(K k) -> Entry<K, V> {
        return new Entry(mut self, k, self.find(k));
    }

    /// Returns `true` when the map has an entry for `k`.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<int, bool> = HashMap::new();
    /// m.insert(7, false);
    /// assert!(m.contains(7));
    /// assert!(!m.contains(8));
    /// ```
    pub fn contains(K k) -> bool {
        return self.idx.find(k) >= 0;
    }

    /// Returns the value stored under `k`, or `fallback` when there is none.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("a", 1);
    /// assert!(m.get_or("a", 0) == 1);
    /// assert!(m.get_or("b", 0) == 0);
    /// ```
    pub fn get_or(K k, V fallback) -> V {
        let s = self.idx.find(k);
        if s >= 0 {
            return self.vals[s];
        }
        return fallback;
    }

    /// Returns the value stored under `k`, or `None` when there is none.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("a", 1);
    /// assert!((m.get("a") ?? 0) == 1);
    /// assert!(m.get("b").is_none());
    /// ```
    pub fn get(K k) -> Option<V> {
        let s = self.idx.find(k);
        if s >= 0 {
            return Some(self.vals[s]);
        }
        return None;
    }

    /// Removes the entry for `k`.
    ///
    /// Returns `true` when there was one.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("a", 1);
    /// assert!(m.remove("a"));
    /// assert!(!m.remove("a"));
    /// assert!(m.is_empty());
    /// ```
    pub fn remove(K k) -> bool {
        if self.idx.remove(k) < 0 {
            return false;
        }
        if self.idx.needs_compact() {
            self.idx.retain_live(self.vals);
            self.idx.compact();
        }
        return true;
    }
}

impl Entry<K: Eq + Hash, V> {
    /// The key this entry is for.
    pub fn key() -> K {
        return self.key;
    }

    /// Whether the map has an entry for the key.
    pub fn exists() -> bool {
        return self.slot >= 0;
    }

    /// The value stored under the key, or `fallback` when there is none.
    pub fn get_or(V fallback) -> V {
        if self.slot >= 0 {
            return self.map.vals[self.slot];
        }
        return fallback;
    }

    /// Returns the value stored under the key, storing `v` there first
    /// when the map has no entry for it.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// assert!(m.entry("a").or_insert(1) == 1);
    /// assert!(m.entry("a").or_insert(2) == 1);
    /// ```
    pub fn or_insert(V v) -> V {
        if self.slot >= 0 {
            return self.map.vals[self.slot];
        }
        self.map.insert(self.key, v);
        return v;
    }

    /// Returns the value stored under the key, storing `make()` there
    /// first when the map has no entry for it. `make` runs only then.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<int, Vec<int>> = HashMap::new();
    /// let v = m.entry(1).or_insert_with(fn () => Vec::new());
    /// assert!(v.len() == 0 && m.contains(1));
    /// ```
    pub fn or_insert_with(() -> V make) -> V {
        if self.slot >= 0 {
            return self.map.vals[self.slot];
        }
        let v = make();
        self.map.insert(self.key, v);
        return v;
    }

    /// Replaces the value stored under the key with `v` when the map has
    /// an entry for it; a missing key stays missing. Returns the entry, so
    /// `or_insert` can follow.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("a", 1);
    /// assert!(m.entry("a").and_update(5).or_insert(0) == 5);
    /// assert!(m.entry("b").and_update(5).or_insert(0) == 0);
    /// ```
    pub fn and_update(V v) -> Entry<K, V> {
        if self.slot >= 0 {
            self.map.vals[self.slot] = v;
        }
        return self;
    }

    /// Replaces the value `old` stored under the key with `f(old)` when
    /// the map has an entry for it; a missing key stays missing. Returns
    /// the entry, so `or_insert` can follow.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// for w in ["a", "b", "a"] {
    ///     let _ = m.entry(w).and_modify(fn (int n) => n + 1).or_insert(1);
    /// }
    /// assert!(m.get_or("a", 0) == 2 && m.get_or("b", 0) == 1);
    /// ```
    pub fn and_modify(V -> V f) -> Entry<K, V> {
        if self.slot >= 0 {
            self.map.vals[self.slot] = f(self.map.vals[self.slot]);
        }
        return self;
    }
}

impl HashMapIter<K, V> {
    /// Returns the next entry, or `None` after the last one.
    pub fn next() -> Option<Pair<K, V>> {
        let n = self.map.vals.len();
        while self.slot < n {
            let s = self.slot;
            self.slot = self.slot + 1;
            if self.map.idx.is_live(s) {
                return Option::Some(new Pair(self.map.idx.key_at(s), self.map.vals[s]));
            }
        }
        return Option::None;
    }
}

impl IntoIterator for HashMap<K, V> {
    type Item = Pair<K, V>;
    type IntoIter = HashMapIter<K, V>;
    pub fn into_iter(HashMap<K, V> m) -> HashMapIter<K, V> {
        return m.iter();
    }
}

impl Iterator for HashMapIter<K, V> {
    type Item = Pair<K, V>;
    pub fn next(HashMapIter<K, V> it) -> Option<Pair<K, V>> {
        return it.next();
    }
}
