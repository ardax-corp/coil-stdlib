// HashMap — insertion-ordered entry slots plus an open-addressing index
// (linear probing), as CPython's compact dict. No Default on K/V.

/// One key-value pair, as `HashMap` iteration yields it.
class Pair<K, V> {
    /// The key.
    pub key: K,
    /// The value stored under `key`.
    pub value: V,
}

/// A hash map from keys of type `K` to values of type `V`.
///
/// Keys need `Eq` and `Hash` (the primitive types have both; `#[derive(Eq, Hash)]`
/// adds them to your own types). Inserting an existing key replaces its value.
/// Iteration (`for e in m`, `m.keys()`, `m.values()`) visits entries in
/// insertion order, skipping removed ones.
///
/// `get` takes a fallback instead of returning an `Option`; use `contains` first
/// when the fallback could be a real value.
///
/// # Examples
///
/// ```
/// use collections::map::{HashMap};
/// # use tests::assert;
/// let ages: HashMap<string, int> = HashMap::new();
/// ages.insert("ada", 36);
/// ages.insert("alan", 41);
/// ages.insert("ada", 37);
/// assert!(ages.len() == 2);
/// assert!(ages.get_or("ada", 0) == 37);
/// assert!(ages.get_or("grace", -1) == -1);
///
/// let total = 0;
/// for e in ages {
///     total = total + e.value;
/// }
/// assert!(total == 78);
/// ```
class HashMap<K, V>
    invariant self.len >= 0 && self.len <= self.keys.len()
    invariant self.cap >= 8 && self.index.len() == self.cap
    invariant self.vals.len() == self.keys.len() && self.hashes.len() == self.keys.len()
    invariant self.live.len() == self.keys.len()
{
    /// `slot + 1` of the entry whose probe sequence passes here, `0` for
    /// empty, `-1` for a removed entry's place. `cap` long, a power of two.
    index: Vec<int>,
    /// Key slots, including removed ones (see `live`). Prefer `keys()`.
    pub keys: Vec<K>,
    /// Value slots parallel to `keys`. Prefer `values()`.
    pub vals: Vec<V>,
    /// Each slot's key hash, so a probe compares hashes before keys and a
    /// grow never hashes again.
    hashes: Vec<int>,
    /// `1` where the slot holds an entry, `0` where it was removed.
    pub live: Vec<int>,
    len: int,
    cap: int,
}

/// An iterator over the entries of a `HashMap`, from `HashMap::iter`.
class HashMapIter<K, V> {
    map: HashMap<K, V>,
    slot: int,
}

impl HashMap<K, V> {
    /// Creates an empty map with room for about `cap` buckets before it grows.
    ///
    /// The bucket count is rounded up to a power of two, at least 8.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<int, string> = HashMap::with_capacity(100);
    /// assert!(m.is_empty());
    /// assert!(m.capacity() >= 100);
    /// ```
    pub static fn with_capacity(int cap) -> HashMap<K, V> {
        let n = 1;
        while n < cap {
            n = n + n;
        }
        if n < 8 {
            n = 8;
        }
        let index: Vec<int> = Vec::with_capacity(n);
        let i = 0;
        while i < n {
            index.push(0);
            i = i + 1;
        }
        let keys: Vec<K> = Vec::new();
        let vals: Vec<V> = Vec::new();
        let hashes: Vec<int> = Vec::new();
        let live: Vec<int> = Vec::new();
        return new HashMap(index, keys, vals, hashes, live, 0, n);
    }

    /// Creates an empty map.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// assert!(m.len() == 0);
    /// ```
    pub static fn new() -> HashMap<K, V> {
        return HashMap::with_capacity(8);
    }

    /// Returns the number of entries.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("a", 1);
    /// m.insert("b", 2);
    /// m.remove("a");
    /// assert!(m.len() == 1);
    /// ```
    pub fn len() -> int {
        return self.len;
    }

    /// Returns `true` when the map has no entries.
    pub fn is_empty() -> bool {
        return self.len == 0;
    }

    /// Returns the number of buckets.
    ///
    /// The map doubles it when it is half full.
    pub fn capacity() -> int {
        return self.cap;
    }

    /// Removes every entry, keeping the bucket count.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<int, int> = HashMap::new();
    /// m.insert(1, 10);
    /// m.clear();
    /// assert!(m.is_empty());
    /// assert!(!m.contains(1));
    /// ```
    pub fn clear()
        ensures self.len == 0
    {
        let i = 0;
        while i < self.cap {
            self.index[i] = 0;
            i = i + 1;
        }
        self.keys = Vec::new();
        self.vals = Vec::new();
        self.hashes = Vec::new();
        self.live = Vec::new();
        self.len = 0;
    }

    /// Returns the keys, in insertion order.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("x", 1);
    /// m.insert("y", 2);
    /// let ks = m.keys();
    /// assert!(ks.len() == 2);
    /// assert!(ks[0] == "x");
    /// ```
    pub fn keys() -> Vec<K>
        ensures result.len() == self.len
    {
        let out: Vec<K> = Vec::new();
        let i = 0;
        while i < self.keys.len() {
            if self.live[i] == 1 {
                out.push(self.keys[i]);
            }
            i = i + 1;
        }
        return out;
    }

    /// Returns the values, in the insertion order of their keys.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("x", 1);
    /// m.insert("y", 2);
    /// let vs = m.values();
    /// assert!(vs[0] + vs[1] == 3);
    /// ```
    pub fn values() -> Vec<V>
        ensures result.len() == self.len
    {
        let out: Vec<V> = Vec::new();
        let i = 0;
        while i < self.vals.len() {
            if self.live[i] == 1 {
                out.push(self.vals[i]);
            }
            i = i + 1;
        }
        return out;
    }

    /// Returns an iterator over the entries, in insertion order.
    ///
    /// `for e in m` does the same; each item is a `Pair` with `key` and `value`.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("a", 1);
    /// let it = m.iter();
    /// let first = match it.next() {
    ///     Option::Some(e) => e.key,
    ///     Option::None => "",
    /// };
    /// assert!(first == "a");
    /// ```
    pub fn iter() -> HashMapIter<K, V> {
        return new HashMapIter(self, 0);
    }
}

impl HashMap<K: Eq + Hash, V> {
    // The slot holding `k` (hash `h`), or `-(p + 1)` where `p` is the index
    // position an insert of `k` takes: the first removed place passed, else
    // the empty one that ended the probe.
    fn probe(K k, int h) -> int {
        let index = self.index;
        let hashes = self.hashes;
        let keys = self.keys;
        let mask = self.cap - 1;
        let i = h & mask;
        let free = -1;
        while true {
            let e = index[i];
            if e > 0 {
                let s = e - 1;
                if hashes[s] == h && keys[s] == k {
                    return s;
                }
            } else if e == 0 {
                if free < 0 {
                    free = i;
                }
                return -(free + 1);
            } else if free < 0 {
                free = i;
            }
            i = (i + 1) & mask;
        }
    }

    // The slot holding `k`, or -1. The hash, with its high bits folded
    // into the low ones the index uses (float hashes are bit patterns with
    // zero low bits), is computed here and in `insert`, `upsert` and
    // `remove` rather than in a helper: a call costs more than the probe.
    fn find(K k) -> int {
        let h = k.hash();
        h = h ^ (h >> 32);
        h = h ^ (h >> 16);
        let index = self.index;
        let mask = self.cap - 1;
        let i = h & mask;
        while true {
            let e = index[i];
            if e > 0 {
                let s = e - 1;
                if self.hashes[s] == h && self.keys[s] == k {
                    return s;
                }
            } else if e == 0 {
                return -1;
            }
            i = (i + 1) & mask;
        }
    }

    // Rebuilds the index over the live slots, dropping removed ones, at
    // twice the size when the live entries alone fill half of it.
    fn grow() {
        let new_cap = self.cap;
        while (self.len + 1) * 2 > new_cap {
            new_cap = new_cap + new_cap;
        }
        let index: Vec<int> = Vec::with_capacity(new_cap);
        let i = 0;
        while i < new_cap {
            index.push(0);
            i = i + 1;
        }
        let keys: Vec<K> = Vec::with_capacity(self.len);
        let vals: Vec<V> = Vec::with_capacity(self.len);
        let hashes: Vec<int> = Vec::with_capacity(self.len);
        let live: Vec<int> = Vec::with_capacity(self.len);
        let mask = new_cap - 1;
        let old_n = self.keys.len();
        let j = 0;
        while j < old_n {
            if self.live[j] == 1 {
                let h = self.hashes[j];
                let p = h & mask;
                while index[p] != 0 {
                    p = (p + 1) & mask;
                }
                keys.push(self.keys[j]);
                vals.push(self.vals[j]);
                hashes.push(h);
                live.push(1);
                index[p] = keys.len();
            }
            j = j + 1;
        }
        self.index = index;
        self.keys = keys;
        self.vals = vals;
        self.hashes = hashes;
        self.live = live;
        self.cap = new_cap;
    }

    // Appends a new entry for `k` at index position `p` (from `probe`).
    fn add_at(int p, K k, int h, V v) {
        self.keys.push(k);
        self.vals.push(v);
        self.hashes.push(h);
        self.live.push(1);
        self.index[p] = self.keys.len();
        self.len = self.len + 1;
    }

    /// Stores `v` under `k`, replacing any value already there.
    ///
    /// Returns `true` when `k` is new and `false` when an existing value was replaced.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// assert!(m.insert("a", 1));
    /// assert!(!m.insert("a", 2));
    /// assert!(m.get_or("a", 0) == 2);
    /// ```
    pub fn insert(K k, V v) -> bool
        ensures !result || self.len == old(self.len) + 1
        ensures result || self.len == old(self.len)
    {
        let h = k.hash();
        h = h ^ (h >> 32);
        h = h ^ (h >> 16);
        let found = self.probe(k, h);
        if found >= 0 {
            self.vals[found] = v;
            return false;
        }
        if (self.keys.len() + 1) * 2 > self.cap {
            self.grow();
            found = self.probe(k, h);
        }
        self.add_at(-found - 1, k, h, v);
        return true;
    }

    /// Stores `init` under `k` when it has no entry, else replaces its value
    /// `old` with `f(old)`, with one lookup. Returns the value now stored.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let counts: HashMap<string, int> = HashMap::new();
    /// for w in ["a", "b", "a"] {
    ///     counts.upsert(w, 1, fn (int n) => n + 1);
    /// }
    /// assert!(counts.get_or("a", 0) == 2);
    /// assert!(counts.get_or("b", 0) == 1);
    /// ```
    pub fn upsert(K k, V init, V -> V f) -> V
        ensures self.len == old(self.len) || self.len == old(self.len) + 1
    {
        let h = k.hash();
        h = h ^ (h >> 32);
        h = h ^ (h >> 16);
        let found = self.probe(k, h);
        if found >= 0 {
            let v = f(self.vals[found]);
            self.vals[found] = v;
            return v;
        }
        if (self.keys.len() + 1) * 2 > self.cap {
            self.grow();
            found = self.probe(k, h);
        }
        self.add_at(-found - 1, k, h, init);
        return init;
    }

    /// Returns the value stored under `k`, storing `v` there first when
    /// `k` has no entry, with one lookup.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// assert!(m.or_insert("a", 1) == 1);
    /// assert!(m.or_insert("a", 2) == 1);
    /// assert!(m.len() == 1);
    /// ```
    pub fn or_insert(K k, V v) -> V
        ensures self.len == old(self.len) || self.len == old(self.len) + 1
    {
        let h = k.hash();
        h = h ^ (h >> 32);
        h = h ^ (h >> 16);
        let found = self.probe(k, h);
        if found >= 0 {
            return self.vals[found];
        }
        self.add_new(found, k, h, v);
        return v;
    }

    /// Returns the value stored under `k`, storing `make()` there first
    /// when `k` has no entry. `make` runs only for a new key.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<int, Vec<int>> = HashMap::new();
    /// let v = m.or_insert_with(1, fn () => Vec::new());
    /// assert!(v.len() == 0);
    /// assert!(m.contains(1));
    /// ```
    pub fn or_insert_with(K k, () -> V make) -> V
        ensures self.len == old(self.len) || self.len == old(self.len) + 1
    {
        let h = k.hash();
        h = h ^ (h >> 32);
        h = h ^ (h >> 16);
        let found = self.probe(k, h);
        if found >= 0 {
            return self.vals[found];
        }
        let v = make();
        self.add_new(found, k, h, v);
        return v;
    }

    /// Replaces the value stored under `k` with `v` when `k` has an
    /// entry; a missing key stays missing. Returns `true` when it had one.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("a", 1);
    /// assert!(m.and_update("a", 5));
    /// assert!(!m.and_update("b", 5));
    /// assert!(m.get_or("a", 0) == 5);
    /// assert!(!m.contains("b"));
    /// ```
    pub fn and_update(K k, V v) -> bool
        ensures self.len == old(self.len)
    {
        let found = self.find(k);
        if found >= 0 {
            self.vals[found] = v;
            return true;
        }
        return false;
    }

    /// Replaces the value `old` stored under `k` with `f(old)` when `k`
    /// has an entry; a missing key stays missing. Returns `true` when it
    /// had one.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("a", 1);
    /// assert!(m.and_update_with("a", fn (int n) => n * 10));
    /// assert!(!m.and_update_with("b", fn (int n) => n * 10));
    /// assert!(m.get_or("a", 0) == 10);
    /// ```
    pub fn and_update_with(K k, V -> V f) -> bool
        ensures self.len == old(self.len)
    {
        let found = self.find(k);
        if found >= 0 {
            self.vals[found] = f(self.vals[found]);
            return true;
        }
        return false;
    }

    // Stores `v` under `k`, which `probe` did not find (`found` is its
    // place as `-(place + 1)`), growing first when the index is half full.
    fn add_new(int found, K k, int h, V v) {
        if (self.keys.len() + 1) * 2 > self.cap {
            self.grow();
            found = self.probe(k, h);
        }
        self.add_at(-found - 1, k, h, v);
    }

    /// Returns `true` when the map has an entry for `k`.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<int, bool> = HashMap::new();
    /// m.insert(7, false);
    /// assert!(m.contains(7));
    /// assert!(!m.contains(8));
    /// ```
    pub fn contains(K k) -> bool {
        return self.find(k) >= 0;
    }

    /// Returns the value stored under `k`, or `fallback` when there is none.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("a", 1);
    /// assert!(m.get_or("a", 0) == 1);
    /// assert!(m.get_or("b", 0) == 0);
    /// ```
    pub fn get_or(K k, V fallback) -> V {
        let s = self.find(k);
        if s >= 0 {
            return self.vals[s];
        }
        return fallback;
    }

    /// Returns the value stored under `k`, or `None` when there is none.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("a", 1);
    /// assert!((m.get("a") ?? 0) == 1);
    /// assert!(m.get("b").is_none());
    /// ```
    pub fn get(K k) -> Option<V> {
        let s = self.find(k);
        if s >= 0 {
            return Some(self.vals[s]);
        }
        return None;
    }

    /// Removes the entry for `k`.
    ///
    /// Returns `true` when there was one.
    ///
    /// # Examples
    ///
    /// ```
    /// use collections::map::{HashMap};
    /// # use tests::assert;
    /// let m: HashMap<string, int> = HashMap::new();
    /// m.insert("a", 1);
    /// assert!(m.remove("a"));
    /// assert!(!m.remove("a"));
    /// assert!(m.is_empty());
    /// ```
    pub fn remove(K k) -> bool
        ensures !result || self.len == old(self.len) - 1
        ensures result || self.len == old(self.len)
    {
        let h = k.hash();
        h = h ^ (h >> 32);
        h = h ^ (h >> 16);
        let mask = self.cap - 1;
        let i = h & mask;
        while self.index[i] != 0 {
            let e = self.index[i];
            if e > 0 {
                let s = e - 1;
                if self.hashes[s] == h && self.keys[s] == k {
                    self.index[i] = -1;
                    self.live[s] = 0;
                    self.len = self.len - 1;
                    return true;
                }
            }
            i = (i + 1) & mask;
        }
        return false;
    }
}

impl HashMapIter<K, V> {
    /// Returns the next entry, or `None` after the last one.
    pub fn next() -> Option<Pair<K, V>> {
        let n = self.map.keys.len();
        while self.slot < n {
            let s = self.slot;
            self.slot = self.slot + 1;
            if self.map.live[s] == 1 {
                let e = new Pair(self.map.keys[s], self.map.vals[s]);
                return Option::Some(e);
            }
        }
        return Option::None;
    }
}

impl IntoIterator for HashMap<K, V> {
    type Item = Pair<K, V>;
    type IntoIter = HashMapIter<K, V>;
    pub fn into_iter(HashMap<K, V> m) -> HashMapIter<K, V> {
        return m.iter();
    }
}

impl Iterator for HashMapIter<K, V> {
    type Item = Pair<K, V>;
    pub fn next(HashMapIter<K, V> it) -> Option<Pair<K, V>> {
        return it.next();
    }
}
