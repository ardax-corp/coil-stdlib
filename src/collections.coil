// Collection helpers (userland): sort, reverse, range materialize.

// Both sorts are a stable bottom-up merge sort: insertion-sort runs of
// `SORT_RUN` elements, then merge runs of doubling width between two buffers
// (each pass writes the other one, so no merge copies its input first). Two
// runs already in order are copied without comparing their elements.

fn sort_run() -> int {
    return 24;
}

// Insertion-sort `buf[lo..hi)` (stable: an element moves left only past
// greater ones).
fn insertion_range<T: Ord>(Vec<T> buf, int lo, int hi) -> int {
    let i = lo + 1;
    while i < hi {
        let x = buf[i];
        let j = i;
        while j > lo && x < buf[j - 1] {
            buf[j] = buf[j - 1];
            j = j - 1;
        }
        buf[j] = x;
        i = i + 1;
    }
    return 0;
}

// Merge sorted `src[lo..mid)` and `src[mid..hi)` into `dst[lo..hi)`
// (stable). With no second run, or two runs already in order, a copy.
fn merge_into<T: Ord>(Vec<T> src, Vec<T> dst, int lo, int mid, int hi) -> int {
    let k = lo;
    if mid >= hi || !(src[mid] < src[mid - 1]) {
        while k < hi {
            dst[k] = src[k];
            k = k + 1;
        }
        return 0;
    }
    let a = lo;
    let b = mid;
    while a < mid && b < hi {
        if src[b] < src[a] {
            dst[k] = src[b];
            b = b + 1;
        } else {
            dst[k] = src[a];
            a = a + 1;
        }
        k = k + 1;
    }
    while a < mid {
        dst[k] = src[a];
        a = a + 1;
        k = k + 1;
    }
    while b < hi {
        dst[k] = src[b];
        b = b + 1;
        k = k + 1;
    }
    return 0;
}

// [`insertion_range`] comparing `key` of each element.
fn insertion_range_by<T, K: Ord>(Vec<T> buf, int lo, int hi, T -> K key) -> int {
    let i = lo + 1;
    while i < hi {
        let x = buf[i];
        let kx = key(x);
        let j = i;
        while j > lo && kx < key(buf[j - 1]) {
            buf[j] = buf[j - 1];
            j = j - 1;
        }
        buf[j] = x;
        i = i + 1;
    }
    return 0;
}

// [`merge_into`] comparing `key` of each element.
fn merge_into_by<T, K: Ord>(Vec<T> src, Vec<T> dst, int lo, int mid, int hi, T -> K key) -> int {
    let k = lo;
    if mid >= hi || !(key(src[mid]) < key(src[mid - 1])) {
        while k < hi {
            dst[k] = src[k];
            k = k + 1;
        }
        return 0;
    }
    let a = lo;
    let b = mid;
    while a < mid && b < hi {
        if key(src[b]) < key(src[a]) {
            dst[k] = src[b];
            b = b + 1;
        } else {
            dst[k] = src[a];
            a = a + 1;
        }
        k = k + 1;
    }
    while a < mid {
        dst[k] = src[a];
        a = a + 1;
        k = k + 1;
    }
    while b < hi {
        dst[k] = src[b];
        b = b + 1;
        k = k + 1;
    }
    return 0;
}

fn min_int(int a, int b) -> int
    ensures result <= a && result <= b
    ensures result == a || result == b
{
    if a < b {
        return a;
    }
    return b;
}

/// Returns a sorted copy of `arr`, in ascending order.
///
/// The sort is stable (equal elements keep their order) and takes `O(n log n)`
/// time. `arr` itself is not changed. Elements need `Ord`; strings compare by
/// their UTF-8 bytes, so `"B"` sorts before `"a"`.
///
/// # Examples
///
/// ```
/// use collections::{sort};
/// # use tests::assert;
/// let xs: Vec<int> = [3, 1, 2];
/// let s = sort(xs);
/// assert!(s[0] == 1 && s[2] == 3);
/// assert!(xs[0] == 3);
/// let words: Vec<string> = ["pear", "Apple", "fig"];
/// assert!(sort(words)[0] == "Apple");
/// ```
fn sort<T: Ord>(Vec<T> arr) -> Vec<T>
    ensures result.len() == arr.len()
{
    let n = arr.len();
    let a: Vec<T> = Vec::with_capacity(n);
    let b: Vec<T> = Vec::with_capacity(n);
    let i = 0;
    while i < n {
        a.push(arr[i]);
        b.push(arr[i]);
        i = i + 1;
    }
    let run = sort_run();
    let lo = 0;
    while lo < n {
        let hi = min_int(lo + run, n);
        insertion_range(a, lo, hi);
        lo = hi;
    }
    let in_a = true;
    let width = run;
    while width < n {
        let pos = 0;
        while pos < n {
            let mid = min_int(pos + width, n);
            let hi = min_int(pos + width + width, n);
            if in_a {
                merge_into(a, b, pos, mid, hi);
            } else {
                merge_into(b, a, pos, mid, hi);
            }
            pos = hi;
        }
        in_a = !in_a;
        width = width + width;
    }
    if in_a {
        return a;
    }
    return b;
}

/// Returns a copy of `arr` sorted by the value `key` gives each element, in ascending order.
///
/// Stable: elements with equal keys keep their order. `key` is called for each
/// comparison, so keep it cheap.
///
/// # Examples
///
/// ```
/// use collections::{sort_by};
/// # use tests::assert;
/// let words: Vec<string> = ["kiwi", "fig", "banana"];
/// let by_len = sort_by(words, fn (string w) => w.len());
/// assert!(by_len[0] == "fig");
/// assert!(by_len[2] == "banana");
/// ```
fn sort_by<T, K: Ord>(Vec<T> arr, T -> K key) -> Vec<T> {
    let n = arr.len();
    let a: Vec<T> = Vec::with_capacity(n);
    let b: Vec<T> = Vec::with_capacity(n);
    let i = 0;
    while i < n {
        a.push(arr[i]);
        b.push(arr[i]);
        i = i + 1;
    }
    let run = sort_run();
    let lo = 0;
    while lo < n {
        let hi = min_int(lo + run, n);
        insertion_range_by(a, lo, hi, key);
        lo = hi;
    }
    let in_a = true;
    let width = run;
    while width < n {
        let pos = 0;
        while pos < n {
            let mid = min_int(pos + width, n);
            let hi = min_int(pos + width + width, n);
            if in_a {
                merge_into_by(a, b, pos, mid, hi, key);
            } else {
                merge_into_by(b, a, pos, mid, hi, key);
            }
            pos = hi;
        }
        in_a = !in_a;
        width = width + width;
    }
    if in_a {
        return a;
    }
    return b;
}

/// Returns a copy of `arr` in reverse order.
///
/// # Examples
///
/// ```
/// use collections::{reverse};
/// # use tests::assert;
/// let xs: Vec<int> = [1, 2, 3];
/// assert!(reverse(xs)[0] == 3);
/// ```
fn reverse<T>(Vec<T> arr) -> Vec<T>
    ensures result.len() == arr.len()
{
    let n = arr.len();
    let out: Vec<T> = Vec::new();
    let i = n;
    while i > 0 {
        i = i - 1;
        out.push(arr[i]);
    }
    return out;
}

/// Returns the values of the range `a..b` as a `Vec<int>`.
///
/// `(a..b).to_vec()` does the same.
///
/// # Examples
///
/// ```
/// use collections::{collect_ints};
/// # use tests::assert;
/// let v = collect_ints(2..5);
/// assert!(v.len() == 3 && v[0] == 2);
/// ```
fn collect_ints(Range<int> r) -> Vec<int> {
    let out: Vec<int> = Vec::new();
    for x in r {
        out.push(x);
    }
    return out;
}

/// Returns the values of the inclusive range `a..=b` as a `Vec<int>`.
fn collect_ints_inclusive(RangeInclusive<int> r) -> Vec<int> {
    let out: Vec<int> = Vec::new();
    for x in r {
        out.push(x);
    }
    return out;
}
